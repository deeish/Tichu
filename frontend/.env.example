# Socket.io backend URL. Leave unset for local dev (defaults to http://localhost:3001).
# In production (Vercel), set to your Render backend URL, e.g.:
# VITE_SOCKET_URL=https://your-app-name.onrender.com
VITE_SOCKET_URL=http://localhost:3001

# Set to true to log when a game-update/game-state is dropped (stale stateVersion) or clone worker ignores an old response.
# Or in the browser: localStorage.setItem('tichu_debug_game_sync','1')
# VITE_DEBUG_GAME_SYNC=true
